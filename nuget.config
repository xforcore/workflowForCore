<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org, and webForCore's feed for webForCore.Serialization.Formatters (workflow persistence and activity cloning). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="webForCore" value="https://xforcore.github.io/webForCore/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="webForCore">
      <package pattern="webForCore.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
