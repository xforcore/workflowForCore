<Project Sdk="Microsoft.NET.Sdk">

  <!-- System.Workflow.ComponentModel (.NET Framework 4.8), from the external/referencesource submodule: Microsoft's
       Reference Source, compiled for .NET 10. Changes to Microsoft's files are commits on xforcore/referencesource's
       workflowforcore branch (docs/MODIFICATIONS.md); what isn't compiled, and why, is in docs/LIFT.md. -->
  <!-- The skeleton: the assembly with its identity and .NET Framework 4.8's strings. Microsoft's files are compiled
       from the next pull request (docs/LIFT.md). -->
  <PropertyGroup>
    <AssemblyName>System.Workflow.ComponentModel</AssemblyName>
    <RootNamespace>System.Workflow.ComponentModel</RootNamespace>
    <PackageId>workflowForCore.ComponentModel</PackageId>
    <Description>System.Workflow.ComponentModel for .NET 10 on Linux and Windows: Windows Workflow Foundation 3's activity model, from Microsoft's .NET Framework 4.8 Reference Source.</Description>
    <Src>$(ReferenceSource)System.Workflow.ComponentModel\</Src>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.8's strings (tools/framework_data.cs). -->
    <EmbeddedResource Include="FrameworkData\System.Workflow.ComponentModel.StringResources.resx" LogicalName="System.Workflow.ComponentModel.StringResources.resources" />
    <EmbeddedResource Include="FrameworkData\System.Workflow.ComponentModel.Compiler.StringResources.resx" LogicalName="System.Workflow.ComponentModel.Compiler.StringResources.resources" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.0" />
    <PackageReference Include="webForCore.Serialization.Formatters" Version="0.10.0" />
  </ItemGroup>

</Project>
