<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>workflowForCore contributors</Authors>
    <Copyright>Copyright (c) workflowForCore contributors. Portions copyright (c) Microsoft Corporation; see NOTICE.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/xforcore/workflowForCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>system.workflow;wf3;windows-workflow-foundation;workflow;linux;net10</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/xforcore/workflowForCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- The README is each package's description page. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
